# Placeholders only. `make .env` writes a real .env with generated local
# values; that file is git-ignored. Never put a real value in this file.

# Password of the local Postgres container (docker-compose.yml).
POSTGRES_PASSWORD=replace-me

# Where the backend finds its database.
DATABASE_URL=postgresql://pokemon:replace-me@127.0.0.1:5433/pokemon

# Bearer token that may start a scan and nothing else. The scheduler holds a copy.
SCAN_TOKEN=replace-me

# Bearer token for the demo controls. Never given to the scheduler.
ADMIN_TOKEN=replace-me-with-a-different-value
